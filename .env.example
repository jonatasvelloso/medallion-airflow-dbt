# Copie para .env (o `make up` faz isso) e troque as senhas.
# O .env está no .gitignore: credenciais nunca vão para o repositório.

AIRFLOW_UID=50000

# Postgres que hospeda as origens fictícias, o DW e os metadados do Airflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Usuário de acesso à interface do Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha
